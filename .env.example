# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://publisher:password@localhost:5432/publisher_db

# Redis
REDIS_URL=redis://localhost:6379

# Authentication abuse protection
# Leave empty for direct connections. Otherwise list ONLY your ingress proxy CIDRs.
# The trusted ingress must overwrite or append the real peer to X-Forwarded-For.
AUTH_TRUSTED_PROXY_CIDRS=

# CORS Origin
CORS_ORIGINS=

# Logging
LOG_LEVEL=info

# Password recovery (API only). Use a verified sending domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Frontend origin used for OAuth redirects and reset links
FRONTEND_URL=

# Encryption
ENCRYPTION_KEY=
# Persist this file across API restarts/deployments. Production never generates it.
JWT_SIGNING_KEY_FILE=./.secrets/jwt-signing-key.pem

# Platform Keys
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CALLBACK_URL=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# Instagram Login. Set all four to enable connecting Instagram accounts.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CALLBACK_URL=
INSTAGRAM_API_VERSION=

# Optional event webhook handshake at /webhooks/instagram.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=


# Platform Mode: 'real' or 'mock' (defaults to 'real' if omitted)
PLATFORM_MODE=real

# Media storage
MEDIA_STORAGE_DRIVER=r2

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=blink-media
R2_ENDPOINT=
R2_REGION=auto

# Upload configuration
MEDIA_MAX_UPLOAD_BYTES=2147483648
MEDIA_PRESIGNED_URL_TTL_SECONDS=900


# TikTok: a domain/prefix verified in TikTok's developer dashboard, routed to API
TIKTOK_MEDIA_URL_PREFIX=
# Dedicated random secret, >=32 bytes, identical on API and worker
TIKTOK_MEDIA_SIGNING_KEY=
TIKTOK_MEDIA_TTL=2h
TIKTOK_POLL_INTERVAL=30s
TIKTOK_POLL_DEADLINE=24h
# Worker requires ffprobe for authoritative video validation

# Optional: exact public signature file downloaded from TikTok, served by API
# Keep the original filename; restart API after adding/changing the file.
TIKTOK_VERIFICATION_FILE=
# Use the exact path requested by TikTok: /tiktok-media/tiktok....txt or /tiktok....txt
TIKTOK_VERIFICATION_PATH=
